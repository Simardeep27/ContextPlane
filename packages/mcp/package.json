{
  "name": "@context-plane/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build -w @context-plane/contracts && npm run build -w @context-plane/persistence && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "start": "node dist/main.js",
    "smoke": "node dist/smoke.js"
  },
  "dependencies": {
    "@context-plane/contracts": "0.0.0",
    "@context-plane/persistence": "0.0.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ajv": "^8.20.0",
    "express": "^5.2.1",
    "langsmith": "^0.10.5",
    "mongodb": "^7.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "tsx": "^4.23.15"
  }
}
