{
  "name": "context-plane",
  "version": "0.0.0",
  "private": true,
  "description": "Scoped, durable agent runtime for the Context Plane POC",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "scenario:seed": "npm run seed -w @context-plane/scenario"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
